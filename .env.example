# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# A Postgres connection string. For local dev, either run Postgres yourself
# (`createdb legacy_notes`) or use a free hosted instance (Neon, Supabase,
# Vercel Postgres) - any of those work here and in production alike.
# See https://pris.ly/d/connection-strings for the full URL format.
DATABASE_URL="postgresql://user:password@localhost:5432/legacy_notes"

# Session cookie signing secret (iron-session). Generate your own for real
# deployments: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET="generate-a-32-byte-base64url-secret"

# Shared secret the external scheduler (cron) must send in the
# `x-cron-secret` header when hitting /api/cron/tick.
CRON_SECRET="generate-a-random-secret"

# Optional: set to send real email via Resend (https://resend.com). When
# unset, all "email" is written to the OutboxEmail table and viewable at
# /admin/outbox instead - fine for local dev and demos.
# RESEND_API_KEY=""
EMAIL_FROM="Legacy Notes <notify@example.com>"

# Public base URL used to build links inside emails (verifier / delivery links).
APP_URL="http://localhost:3000"
